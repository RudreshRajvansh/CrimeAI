# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=development
LOG_FORMAT=console

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-in-any-shared-environment-0123456789abcdef
JWT_SECRET_KEY=change-me-in-any-shared-environment-0123456789abcdef

DATABASE_URL=postgresql+asyncpg://crimeai:crimeai_dev_password@localhost:5432/crimeai
DATABASE_URL_SYNC=postgresql://crimeai:crimeai_dev_password@localhost:5432/crimeai
# Set to 0 when connecting through PgBouncer/Supabase pooler in transaction mode.
DB_STATEMENT_CACHE_SIZE=100

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*
# Local HTTP dev cannot set Secure cookies.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/uploads

ENABLE_ZERO_SHOT=false
# Access requests stay pending until an administrator approves them.
ALLOW_SELF_REGISTRATION=true

# Patrol routes are drawn on the road network via OSRM. The public server receives
# checkpoint coordinates; point this at a self-hosted OSRM for operational use.
ROUTING_ENABLED=true
ROUTING_URL=https://routing.openstreetmap.de


# Gemini case briefs: English translation and summary of any FIR. Leave empty to keep the feature off.
# Only PII-redacted text is sent. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

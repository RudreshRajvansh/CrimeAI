# Leave VITE_API_URL empty: the app calls its own origin and the host (Vite in dev, Vercel in prod)
# proxies /api to the backend, which keeps the session cookie first-party.
VITE_API_URL=
# WebSockets cannot go through Vercel rewrites, so production points straight at the API host.
# Empty means "same origin" (works in dev through the Vite proxy).
VITE_WS_URL=
